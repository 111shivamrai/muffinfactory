rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Master Gate Pattern
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper for Session Access
    function getSession(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function isInstructor(sessionId) {
      return isSignedIn() && getSession(sessionId).instructorId == request.auth.uid;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Sessions
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isInstructor(sessionId);
      allow delete: if false;
    }

    // Teams
    match /sessions/{sessionId}/teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && teamId == request.auth.uid;
      allow update: if isSignedIn();
    }

    // Decisions
    match /sessions/{sessionId}/teams/{teamId}/decisions/{roundId} {
      allow read: if isOwner(teamId) || isInstructor(sessionId);
      allow create: if isOwner(teamId);
      allow update: if false; // Decisions are final once submitted (usually)
    }

    // Results
    match /sessions/{sessionId}/teams/{teamId}/results/{roundId} {
      allow read: if isOwner(teamId) || isInstructor(sessionId);
      allow create, update: if isSignedIn();
    }

    // Commercial Licenses (SaaS limits / seat configurations)
    match /licenses/{licenseId} {
      allow read, write: if isSignedIn();
    }

    // SaaS System Logging (centralized error metrics/crash logs)
    match /system_logs/{logId} {
      allow create: if true; // Any operator/student client experiencing an issue can report their stacktrace
      allow read, update, delete: if isSignedIn();
    }

    // System Notifications / Banner Broadcasts
    match /system_notifications/{id} {
      allow read: if true;
      allow writeOrUpdate, write: if isSignedIn();
    }
  }
}
